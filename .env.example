# ─────────────────────────────────────────────────────────────
# ฐานข้อมูล PostgreSQL (อยู่บน CHUEY-Server)
# ─────────────────────────────────────────────────────────────

# ตั้งรหัสผ่านให้ยาวและเดายาก — ใช้ทั้ง docker-compose และ DATABASE_URL
# สร้างรหัสสุ่มได้ด้วย: openssl rand -base64 24
POSTGRES_DB=tiamthep
POSTGRES_USER=tiamthep
POSTGRES_PASSWORD=เปลี่ยนรหัสนี้ก่อนใช้จริง

# ที่อยู่ฐานข้อมูลที่แอปจะต่อ
#
# แอปรันบนเครื่องเดียวกับฐานข้อมูล (CHUEY-Server) — แบบที่แนะนำ
DATABASE_URL="postgresql://tiamthep:เปลี่ยนรหัสนี้ก่อนใช้จริง@127.0.0.1:5432/tiamthep?schema=public"
#
# แอปรันคนละเครื่องกับฐานข้อมูล — ใส่ชื่อเครื่องหรือ IP ของ CHUEY-Server
# ต้องเปลี่ยน port ใน docker-compose.yml เป็น "5432:5432" ก่อน และควรบังคับ SSL
# DATABASE_URL="postgresql://tiamthep:รหัสผ่าน@CHUEY-Server:5432/tiamthep?schema=public&sslmode=require"

# ─────────────────────────────────────────────────────────────
# แอป
# ─────────────────────────────────────────────────────────────

# รหัสผ่านสำหรับเข้าหน้าผู้ดูแล (ฐานข้อมูล + รายงาน)
# ปล่อยว่าง = ไม่ล็อก (ใช้ตอนทดสอบเท่านั้น)
ADMIN_PASSWORD="TT2026"

# โซนเวลา — มีผลกับการตัดวันในรายงาน
TZ=Asia/Bangkok
