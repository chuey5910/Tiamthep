# ─────────────────────────────────────────────────────────────
#  ไฟล์ตั้งค่าสำหรับรันบน NAS
#
#  ก๊อปไฟล์นี้ไปวางที่  /volume1/docker/tiamthep/secrets/.env
#  แล้วแก้ค่าตามด้านล่าง  (ห้ามเอาไฟล์จริงขึ้น git เด็ดขาด)
#
#  ตั้งสิทธิ์ให้เฉพาะเจ้าของอ่านได้:  chmod 600 secrets/.env
# ─────────────────────────────────────────────────────────────

# ── ฐานข้อมูล ──────────────────────────────────────────────
# ตั้งรหัสใหม่ได้เลย ไม่ต้องเหมือนของเครื่องเดิม (สุ่มด้วย: openssl rand -hex 16)
POSTGRES_DB=tiamthep
POSTGRES_USER=tiamthep
POSTGRES_PASSWORD=ตั้งรหัสผ่านใหม่ตรงนี้

# ที่อยู่ฐานข้อมูลที่เว็บจะต่อ
#   "db" คือชื่อกล่องฐานข้อมูลในชุดเดียวกัน ไม่ใช่ชื่อเครื่อง — อย่าเปลี่ยนเป็น IP
#   รหัสผ่านต้องตรงกับ POSTGRES_PASSWORD ข้างบน
DATABASE_URL="postgresql://tiamthep:ตั้งรหัสผ่านใหม่ตรงนี้@db:5432/tiamthep?schema=public"

# ── การเข้าใช้งาน ──────────────────────────────────────────
# พอร์ตบน NAS — เช็คว่าว่างก่อนด้วย:  ss -tln | grep :3100
# เข้าใช้งานที่  http://192.168.1.51:3100  (ในบ้าน)
#            หรือ http://<IP 100.x ของ NAS>:3100  (นอกบ้าน ผ่าน Tailscale)
APP_PORT=3100

# ตั้งเป็น 1 เฉพาะเมื่อเปิดผ่าน HTTPS แล้วเท่านั้น
# ถ้าตั้งตอนยังเป็น http เบราว์เซอร์จะทิ้ง cookie — ล็อกอินไม่ติดจากทุกเครื่อง
COOKIE_SECURE=0

TZ=Asia/Bangkok

# ── เชื่อมกับชีตสั่งงาน / ไลน์ ────────────────────────────────
#
#  ⚠ สำคัญที่สุดตอนย้ายเครื่อง:
#  ให้เว็บที่ "เชื่อมชีตได้" มีทีละเครื่องเดียวเท่านั้น
#  ตอนทดสอบบน NAS ช่วงแรก ให้ปล่อยสองค่านี้ว่างไว้ก่อน
#  แล้วค่อยมาเติมตอนปิดเว็บฝั่ง Mac แล้วจริงๆ
#  ถ้าเปิดพร้อมกันสองเครื่อง ทั้งคู่จะแย่งกันดึงงานและเขียนสถานะทับกันในชีต
#
# รหัสชีต — เอาค่าเดิมจากไฟล์ .env ของเครื่อง Mac (ตัวเดียวกันเป๊ะ)
LINE_SHEET_ID=

# กุญแจ Google — ต้องเป็นที่อยู่ไฟล์ "ในกล่อง" ไม่ใช่ที่อยู่บน NAS
# โฟลเดอร์ secrets/ ของ NAS ถูกผูกเข้าไปเป็น /secrets ในกล่องให้แล้ว
# จึงก๊อปไฟล์ .json ไปวางที่ secrets/google-service-account.json แล้วใช้ค่านี้ได้เลย
GOOGLE_SERVICE_ACCOUNT_FILE=/secrets/google-service-account.json
